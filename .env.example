# Cosmic Watch - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!

# ============================================
# DJANGO SETTINGS
# ============================================
DEBUG=True
SECRET_KEY=your-secret-key-here-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.railway.app

# ============================================
# DATABASE CONFIGURATION (RAILWAY)
# ============================================
# Option 1: Use full DATABASE_URL (Recommended for Railway)
DATABASE_URL=postgresql://user:password@host.railway.app:5432/railway

# Option 2: Or use individual variables
# DB_HOST=your-db-host.railway.app
# DB_PORT=5432
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=your-password-here
# DB_SSL_MODE=require

# ============================================
# LOCAL DOCKER DATABASE (Development)
# ============================================
# Uncomment these for local Docker development
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cosmic_watch
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL_MODE=prefer

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-frontend.railway.app

# ============================================
# REDIS CONFIGURATION
# ============================================
# Local Redis
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Railway Redis (if you add Redis service)
# CELERY_BROKER_URL=redis://default:password@redis.railway.internal:6379
# CELERY_RESULT_BACKEND=redis://default:password@redis.railway.internal:6379

# ============================================
# NASA API
# ============================================
NASA_API_KEY=BtS3sRoAXOeRx0YS8M5EjFUYvblVAJd6CZy3mulD

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# JWT TOKEN SETTINGS (Optional Override)
# ============================================
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ============================================
# RAILWAY SPECIFIC (Production)
# ============================================
# These are automatically set by Railway, no need to add manually:
# - PORT (Railway automatically sets this)
# - RAILWAY_ENVIRONMENT
# - RAILWAY_PROJECT_ID
# - RAILWAY_SERVICE_ID

# ============================================
# STATIC AND MEDIA FILES
# ============================================
# For Railway deployments with S3/Cloudinary
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1

# ============================================
# MONITORING AND LOGGING (Optional)
# ============================================
# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=INFO
