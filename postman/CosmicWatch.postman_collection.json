    {
      "name": "Asteroids",
      "description": "NEO Asteroid Data Endpoints",
      "item": [
        {
          "name": "List All Asteroids",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Asteroids array returned', function() {",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Asteroid objects have required fields', function() {",
                  "    if (jsonData.length > 0) {",
                  "        pm.expect(jsonData[0]).to.have.property('name');",
                  "        pm.expect(jsonData[0]).to.have.property('diameter');",
                  "        pm.expect(jsonData[0]).to.have.property('is_potentially_hazardous');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
