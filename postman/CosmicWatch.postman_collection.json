                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/asteroids/?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "asteroids", ""],
